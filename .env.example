# Copy this file to .env and fill in the values. Never commit .env.

# Provider API keys (one account per provider)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Infrastructure
REDIS_URL=
DATABASE_URL=

# Admin dashboard: secret that encrypts the session cookie, at least 32 characters.
# Generate it with: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=

# Lost operator password? Add OPERATOR_RECOVERY=true, restart the admin API and use
# the one-time recovery token it prints in its log. Remove it again once done.

# Local PostgreSQL credentials used by docker compose (defaults: gateway)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
