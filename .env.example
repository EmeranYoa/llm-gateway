# Copy this file to .env and fill in the values. Never commit .env.

# Provider API keys (one account per provider)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Infrastructure
REDIS_URL=
DATABASE_URL=

# Gateway worker processes (default 2): about one per CPU core, about 100 MB of RAM each.
# The admin API always runs one.
WEB_CONCURRENCY=

# Connections to the providers, per gateway worker (defaults: 200 open, 100 kept idle)
UPSTREAM_MAX_CONNECTIONS=
UPSTREAM_MAX_KEEPALIVE=

# Admin dashboard: secret that encrypts the session cookie, at least 32 characters.
# Generate it with: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=

# Lost operator password? Add OPERATOR_RECOVERY=true, restart the admin API and use
# the one-time recovery token it prints in its log. Remove it again once done.

# Local PostgreSQL credentials used by docker compose (defaults: gateway)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
